  "query": "SELECT id, account_id, raw_rfc822_blob, envelope, retry_count, last_error, created_at\n             FROM outbox\n             WHERE sent_at IS NULL\n               AND (next_attempt_at IS NULL OR next_attempt_at <= ?1)\n               AND (send_after IS NULL OR send_after <= ?1)\n             ORDER BY created_at",
